---
layout: base.njk
title: Home
---

<div class="hero">
    <h2>Welcome to My Book Previews</h2>
    <p>Explore previews of my latest works of fiction</p>
</div>

<div class="books-grid">
    {% for book in books %}
    <article class="book-card">
        <div class="book-cover">
            {% if book.coverImage %}
            <img src="{{ book.coverImage | url }}" alt="{{ book.title }} cover" class="cover-image">
            {% else %}
            <div class="placeholder-cover">{{ book.title[0] }}</div>
            {% endif %}
        </div>
        <div class="book-info">
            <h3>{{ book.title }}</h3>
            <p>{{ book.description }}</p>
            <div class="book-meta">
                {% set chapterCount = 0 %}
                {% for chapter in collections.chapters %}
                    {% if chapter.data.bookId == book.id %}
                        {% set chapterCount = chapterCount + 1 %}
                    {% endif %}
                {% endfor %}
                <span>{{ chapterCount }} chapters available</span>
            </div>
            <a href="{{ ('/books/' + book.id + '/') | url }}" class="btn">Read Preview</a>
        </div>
    </article>
    {% endfor %}
</div>
